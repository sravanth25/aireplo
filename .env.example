# Copy these into Vercel → Project → Settings → Environment Variables. Never commit real values.

# Claude API key from https://console.anthropic.com (powers the website chat and the WhatsApp bot)
ANTHROPIC_API_KEY=

# Optional: change the AI model (default claude-opus-5-5)
# AI_MODEL=

# Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp)
WHATSAPP_TOKEN=              # permanent System User access token
WHATSAPP_PHONE_NUMBER_ID=    # "Phone number ID" (not the phone number itself)
WHATSAPP_APP_SECRET=         # App settings → Basic → App secret (verifies messages really come from Meta)
WHATSAPP_VERIFY_TOKEN=       # any password you make up; paste the same value in Meta's webhook settings
# GRAPH_API_VERSION=v23.0
